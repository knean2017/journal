te_design_open_items", "target": "readme_open_items", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-26-icrr-journal-website-design.md", "source_location": "L543-557", "weight": 1.0}, {"source": "specs_2026_07_26_icrr_journal_website_design_out_of_scope", "target": "design_reference_readme_review_policy_copy", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-07-26-icrr-journal-website-design.md", "source_location": "L532", "weight": 1.0}, {"source": "specs_2026_07_26_icrr_journal_website_design_announcement_rotator", "target": "design_reference_icrr_journal_dc_componentdidmount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-26-icrr-journal-website-design.md", "source_location": "L420", "weight": 1.0}], "hyperedges": []}
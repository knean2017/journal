{"nodes": [{"id": "assets_icrr_lockup_stacked_transparent", "label": "ICRR Stacked Lockup (Transparent)", "file_type": "image", "source_file": "design-reference/assets/icrr_lockup_stacked_transparent.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Portrait-ish lockup: large quadrant mark centered above a horizontal rule, with the two-line centered wordmark beneath. Vertical stacking suits covers, title pages, print PDFs and narrow/mobile viewports where the horizontal lockup would have to shrink below legibility."}, {"id": "assets_icrr_lockup_stacked_transparent_horizontal_rule", "label": "Horizontal Hairline Divider", "file_type": "concept", "source_file": "design-reference/assets/icrr_lockup_stacked_transparent.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A thin horizontal rule, narrower than the mark, separates the mark from the centered wordmark below. Same separator role as the vertical rule in the horizontal lockup, rotated 90 degrees to match the stacked axis."}, {"id": "assets_icrr_lockup_stacked_transparent_centered_axis", "label": "Centered Vertical Composition Axis", "file_type": "concept", "source_file": "design-reference/assets/icrr_lockup_stacked_transparent.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark, rule and both wordmark lines share one centered axis, and the rule's width is keyed to the wordmark measure rather than the mark. Centering is the title-page convention this variant is aimed at, and contrasts with the horizontal lockup's left-aligned, baseline-driven arrangement."}], "edges": [{"source": "assets_icrr_lockup_stacked_transparent", "target": "assets_icrr_mark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-reference/assets/icrr_lockup_stacked_transparent
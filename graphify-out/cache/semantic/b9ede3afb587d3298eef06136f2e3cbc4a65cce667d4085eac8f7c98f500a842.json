{"nodes": [{"id": "design_reference_icrr_journal_dc_component", "label": "Component (DCLogic subclass)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L866-1001", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single React-like class holding all ten views. state = { page, authorId, filter, q, ann, toast, narrow, menuOpen }."}, {"id": "design_reference_icrr_journal_dc_componentdidmount", "label": "componentDidMount", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L869-877", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starts the 6000ms announcement interval, registers the matchMedia('(max-width: 860px)') change listener, and arms the reveal."}, {"id": "design_reference_icrr_journal_dc_componentdidupdate", "label": "componentDidUpdate", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L878-884", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On page change: window.scrollTo(0,0) and re-arm the reveal."}, {"id": "design_reference_icrr_journal_dc_componentwillunmount", "label": "componentWillUnmount", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L885-889", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clears the interval, disconnects the IntersectionObserver, removes the matchMedia listener."}, {"id": "design_reference_icrr_journal_dc_reveal", "label": "_reveal", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L891-911", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds the IntersectionObserver with rootMargin '0px 0px -12% 0px'. Line 906 is the critical guard: if getBoundingClientRect().top < window.innerHeight * 0.92 the element is returned over and never hidden."}, {"id": "design_reference_icrr_journal_dc_nav", "label": "nav(page)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L913", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a click handler that sets page, closes the menu, and clears authorId unless navigating to the author view."}, {"id": "design_reference_icrr_journal_dc_togglemenu", "label": "toggleMenu", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L914", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_reference_icrr_journal_dc_closemenu", "label": "closeMenu", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L915", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calls stopPropagation so the scrim handler does not double-fire."}, {"id": "design_reference_icrr_journal_dc_note", "label": "note(msg)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L916", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toast factory: clears any pending timeout before setting a new message, then auto-clears after 3600ms."}, {"id": "design_reference_icrr_journal_dc_rendervals", "label": "renderVals", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L918-1000", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes every template binding in one pass: page flags, nav handlers and gold underlines, the author matcher and visible list, filter chips, countLabel, the three placeholder toast handlers, and the deadline/expected props."}, {"id": "design_reference_icrr_journal_dc_matches", "label": "matches (author search predicate)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L927-932", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discipline chip first, then a case-insensitive substring test over a haystack of name, affiliation, discipline, role, bio, joined interests, and joined publication titles."}, {"id": "design_reference_icrr_journal_dc_authors", "label": "AUTHORS (six placeholder profiles)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L758-783", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_reference_icrr_journal_dc_disciplines", "label": "DISCIPLINES (five sections)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L750-756", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_reference_icrr_journal_dc_announcements", "label": "ANNOUNCEMENTS (three ticker strings)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L785-789", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_reference_icrr_journal_dc_news", "label": "NEWS (three announcement articles)", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L791-798", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_reference_icrr_journal_dc_steps", "label": "STEPS / TIMELINE / TOC_PREVIEW / FACTS / REQS / CHECKLIST", "file_type": "code", "source_file": "design-reference/ICRR Journal.dc.html", "source_location": "L800-857", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prototype's process, timeline, ToC preview, journal-at-a-glance facts, manuscript requirements and pre-submission checklist copy. S
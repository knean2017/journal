{"nodes": [{"id": "plans_2026_07_26_icrr_public_site_plan", "label": "ICRR Journal Public Site Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan 1 of 3: foundation and public site, spec phases 1-5 plus 8. Plan 2 covers Supabase schema, RLS, storage and admin; plan 3 covers submissions, upload, Resend and newsletter. Line numbers cited throughout refer to the prototype as it exists at commit 8272b44."}, {"id": "plans_2026_07_26_icrr_public_site_deviation_spec_14", "label": "Deviation from Spec \u00a714 (own Zod schemas first)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L14-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec sequenced the Supabase schema at phase 2 so views would be built against real types. The plan instead defines domain types as Zod schemas the project owns, and the Supabase layer added in plan 2 maps database rows into those same types. Benefits: no Docker or Supabase credentials are needed to build the entire public site, generated database types never leak into view code, and the data source stays genuinely swappable."}, {"id": "plans_2026_07_26_icrr_public_site_global_constraints", "label": "Plan Global Constraints", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L28-43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicitly included in every task: rebuild branch only, no border radius, one shadow, no em dashes, never promise reviewer feedback, only the 14 color tokens plus enumerated rgba, clamp() reproduced verbatim, single 860px breakpoint, 'Our Team' never 'Editorial Board', TypeScript strict with no any, server components by default, commit after every task."}, {"id": "plans_2026_07_26_icrr_public_site_globals_css", "label": "globals.css Tokens, Reset, Keyframes, Component Classes", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L260-454", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declares the 14 --color-* variables under Tailwind @theme, a global border-radius: 0 reset, the six icrr* keyframes, and .eyebrow/.rule-double/.btn-*/.panel/.card/.callout-gold/.field. #D2B67E is the one hex outside the 14 tokens, permitted because it appears exactly once as the gold button hover."}, {"id": "plans_2026_07_26_icrr_public_site_tokens_test", "label": "tests/unit/tokens.test.ts", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L174-253", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards the single highest-risk thing at scaffold stage: a mistyped hex propagates into every view. Asserts whitespace-normalised keyframe bodies, not just names, so a later task cannot silently alter a motion curve. Also asserts exactly one box-shadow declaration and a global border-radius reset."}, {"id": "plans_2026_07_26_icrr_public_site_domain_schema", "label": "Zod Domain Schema (src/lib/content/schema.ts)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L652-811", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SiteConfig, Discipline, TeamMember, EditorialRole, Author, Issue, Article, ArticleAuthor, Announcement, TickerLine, ProcessStep, TimelineEntry, Requirement, Fact, TocPreviewEntry. Types the project owns, so Supabase rows are mapped into them rather than generated types leaking into views."}, {"id": "plans_2026_07_26_icrr_public_site_seed_data", "label": "Seed Data (src/lib/content/seed/*)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L813-1127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every string copied verbatim from the prototype at cited line numbers, never paraphrased. Notable transforms: the prototype's trailing \\n in two role values is a data artefact and must be dropped; publications move out of the author record into articles.ts joined by getArticlesByAuthor; ROLES.holder becomes statusLabel and ROLES.color becomes status; NEWS.ctaKey becomes a real href."}, {"id": "plans_2026_07_26_icrr_public_site_content_accessors", "label": "Content Accessors (src/lib/content/index.ts)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1129-1222", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every accessor is async from day one so plan 2 can swap the body for a Supabase query with no call-site change, and validates through Zod on the way out so a malformed seed fails loudly here rather than silently rendering wrong. Unknown slugs return null rather than throwing."}, {"id": "plans_2026_07_26_icrr_public_site_authors_filter", "label": "Author Filter and Search (src/lib/authors/filter.ts)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1241-1296", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracted as its own task because it is the only non-trivial logic on the public site and the prototype's exact matching behaviour must be preserved. Produces buildAuthorCards, filterAuthors, publicationLabel, countLabel and the AuthorCard type."}, {"id": "plans_2026_07_26_icrr_public_site_armreveal", "label": "armReveal (src/lib/reveal.ts)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1423-1434", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns a disconnect function; paired with a <Reveal> wrapper rendering <section data-reveal>. The guard at prototype line 906 is the critical behaviour: an element already within 92% of the viewport height on arrival is never hidden, so nothing above the fold flashes blank."}, {"id": "plans_2026_07_26_icrr_public_site_ui_primitives", "label": "UI Primitives (Container, Eyebrow, PageHead, Button, Panel, Callout, ImageSlot)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1614-1629", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Container carries the 1180px content width and the 1400px wide variant; ImageSlot renders next/image when src is set, otherwise the dashed placeholder."}, {"id": "plans_2026_07_26_icrr_public_site_chrome_task", "label": "Task 6: Global Chrome", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L1870-1878", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_07_26_icrr_public_site_view_tasks", "label": "Tasks 7 to 16: The Ten Views", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L2544-3110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Home, About, Current Issue, Archives, Authors directory, Author profile, Our Team, Submit, Announcements, Article reading page. Each view gets one route file plus per-section components under src/components/site/<view>/ and a Playwright spec."}, {"id": "plans_2026_07_26_icrr_public_site_design_audit", "label": "Task 17: Design Audit", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L3111-3235", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The automated guard that turns the copy rules and visual constraints into failing tests rather than review comments."}, {"id": "plans_2026_07_26_icrr_public_site_netlify_task", "label": "Task 18: Netlify Deploy", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L3236-3302", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "plans_2026_07_26_icrr_public_site_plan", "target": "specs_2026_07_26_icrr_journal_website_design_spec", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L11", "weight": 1.0}, {"source": "plans_2026_07_26_icrr_public_site_plan", "target": "design_reference_icrr_journal_dc_component", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L12", "weight": 1.0}, {"source": "plans_2026_07_26_icrr_public_site_deviation_spec_14", "target": "specs_2026_07_26_icrr_journal_website_design_build_phases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L14-16", "weight": 1.0}, {"source": "plans_2026_07_26_icrr_public_site_deviation_spec_14", "target": "plans_2026_07_26_icrr_public_site_domain_schema", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-26-icrr-public-site.md", "source_location": "L16", "weight": 1.0}, {"source": "plans_2026_07_26_icrr_public_site_global_constraints", "target": "design_reference_readme_copy_rules", "relation": "implements", "confidence": "EXTRACTED", "conf
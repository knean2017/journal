# The site's own address, with no trailing slash. Used for canonical links, the
# sitemap, and the card chat apps draw for a pasted link, all of which need an
# absolute URL. Netlify sets URL itself, so a Netlify deploy is usually right
# without this. Left unset elsewhere, those URLs come out as localhost, which
# is deliberately obvious rather than plausibly wrong.
NEXT_PUBLIC_SITE_URL=

# Supabase. Until these are set the site serves its seed content, so it builds
# and deploys with no database attached.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS, so every write goes through it. Never expose this
# to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Where the admin panel answers. Obscurity is a second layer, not the control:
# the session check is what protects it. Change this without touching code.
ADMIN_PATH=editorial-office

# Plan 3.
RESEND_API_KEY=
